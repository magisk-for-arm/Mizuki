---
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import { sidebarLayoutConfig, siteConfig } from "../config";
import localGalgameList from "../data/galgame";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

interface GalgameItem {
	title: string;
	cover: string;
	link: string;
	status: string;
	rating: number;
	progress: number;
	description: string;
	year: string;
	developer: string;
	tags: string[];
}

if (!siteConfig.featurePages.galgame) {
	return Astro.redirect("/404/");
}

const isBothSidebarMode = sidebarLayoutConfig.position === "both";
const GALGAME_MODE = siteConfig.galgame?.mode || "local";

let galgameList: GalgameItem[] = [];

if (GALGAME_MODE === "local") {
	galgameList = localGalgameList;
} else {
	try {
        // @ts-ignore
        const bangumiData = await import("../data/bangumi-galgame-data.json");
        galgameList = bangumiData.default || [];
    } catch (e) {
        console.error("Failed to load Bangumi Galgame data:", e);
        galgameList = [];
    }
}

function getStatusInfo(status: string) {
	switch (status) {
		case "playing":
			return {
				text: i18n(I18nKey.animeStatusWatching), // Reuse 'Watching' for Playing
				class: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
				icon: "▶",
			};
		case "completed":
			return {
				text: i18n(I18nKey.animeStatusCompleted),
				class: "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
				icon: "✓",
			};
		case "planned":
			return {
				text: i18n(I18nKey.animeStatusPlanned),
				class: "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300",
				icon: "❤",
			};
		case "dropped":
			return {
				text: i18n(I18nKey.animeStatusDropped),
				class: "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300",
				icon: "✗",
			};
		default:
			return {
				text: status,
				class: "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300",
				icon: "?",
			};
	}
}

const INITIAL_DISPLAY_COUNT = 24;
const visibleGalgameList = galgameList.slice(0, INITIAL_DISPLAY_COUNT);
const hiddenGalgameList = galgameList.slice(INITIAL_DISPLAY_COUNT);
---

<MainGridLayout
	title="Galgame"
	description="Galgame Collection"
>
	<div
		class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
	>
		<div class="card-base galgame-card-base z-10 px-9 py-6 relative w-full">
			<div class="relative w-full mb-8">
				<div class="mb-6">
					<h1
						class="text-4xl font-bold text-black/90 dark:text-white/90 mb-2 relative
                    before:w-1 before:h-8 before:rounded-md before:bg-[var(--primary)]
                    before:absolute before:top-1/2 before:-translate-y-1/2 before:-left-4"
					>
						Galgame
					</h1>
					<p class="text-black/75 dark:text-white/75">
						我玩过 / 正在玩的 Galgame
					</p>
				</div>

				<div class="mb-6">
					<div class="galgame-filter-container flex flex-wrap gap-2">
						<button
							class="galgame-filter-tag galgame-active"
							data-status="all"
							>{i18n(I18nKey.animeFilterAll)}</button
						>
						<button class="galgame-filter-tag" data-status="playing"
							>{i18n(I18nKey.animeStatusWatching)}</button
						>
						<button class="galgame-filter-tag" data-status="planned"
							>{i18n(I18nKey.animeStatusPlanned)}</button
						>
						<button class="galgame-filter-tag" data-status="completed"
							>{i18n(I18nKey.animeStatusCompleted)}</button
						>
                        <button class="galgame-filter-tag" data-status="dropped"
							>{i18n(I18nKey.animeStatusDropped)}</button
						>
					</div>
				</div>
			</div>

			<div class="mb-8">
				{
					visibleGalgameList.length > 0 ? (
						<>
							<div
								id="galgame-list-container"
								class={`galgame-grid-container grid gap-4 md:gap-6 opacity-0 transition-opacity duration-300`}
							>
								{visibleGalgameList.map((game) => {
									const statusInfo = getStatusInfo(
										game.status,
									);
                                    // Progress bar logic - if progress is 0-100
									const progressPercent = game.progress || 0;

									return (
										<div
											class="group relative bg-[var(--card-bg)] border border-[var(--line-divider)] rounded-[var(--radius-large)] overflow-hidden hover:shadow-lg"
											data-galgame-status={game.status}
										>
											<div class="relative galgame-cover-container aspect-[2/3] overflow-hidden">
												<a
													href={game.link}
													target="_blank"
													rel="noopener noreferrer"
													class="block w-full h-full"
												>
													<ImageWrapper
														src={game.cover}
														alt={game.title}
														class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-110"
													/>
													<div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
														<div class="absolute inset-0 flex items-center justify-center">
															<div class="w-12 h-12 rounded-full bg-white/90 flex items-center justify-center">
																<svg
																	class="w-6 h-6 text-gray-800 ml-1"
																	fill="currentColor"
																	viewBox="0 0 24 24"
																>
																	<path d="M8 5v14l11-7z" />
																</svg>
															</div>
														</div>
													</div>
												</a>

												<div
													class={`absolute top-2 left-2 px-2 py-1 rounded-md text-xs font-medium ${statusInfo.class}`}
												>
													<span class="mr-1">
														{statusInfo.icon}
													</span>
													<span>
														{statusInfo.text}
													</span>
												</div>

												<div class="absolute top-2 right-2 bg-black/70 text-white px-2 py-1 rounded-md text-xs font-medium flex items-center gap-1">
													<svg
														class="w-3 h-3 text-yellow-400"
														fill="currentColor"
														viewBox="0 0 20 20"
													>
														<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
													</svg>
													<span>{game.rating}</span>
												</div>

